# Machine Translation Backends
#
# MinT (https://translate.wmcloud.org) is the default backend and needs no
# API key. Optionally override its endpoint:
# MINT_API_URL=https://translate.wmcloud.org/api/translate

# Google Translate is offered as an additional backend only when a key is set.
# GOOGLE_TRANSLATE_API_KEY=your_api_key_here

# Server Configuration
# RUST_LOG=debug,banana_i18n_mt_web=info
